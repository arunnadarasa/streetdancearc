pragma language_version 0.23;
import CompactStandardLibrary;

// StreetRail Move Rights NFT on Midnight Undeployed.
// Only Map.insert of *new* keys is dust-wallet-safe on this stack.
// Updating an existing key (lookup/member or overwrite) trips
// wasm.transaction_merge / feesWithMargin Unreachable.
// Buy is therefore an append-only sale receipt; current owner lives in the local mirror.
export ledger owners: Map<Bytes<32>, Bytes<32>>;
export ledger listed_price: Map<Bytes<32>, Uint<64>>;
export ledger sales: Map<Bytes<32>, Bytes<32>>;

witness localSecretKey(): Bytes<32>;

export circuit mint(tokenId: Bytes<32>, to: Bytes<32>): [] {
  const sk = localSecretKey();
  const auth = persistentHash<Vector<2, Bytes<32>>>([pad(32, "movenft:minter:v1"), sk]);
  assert(auth != pad(32, ""), "auth");
  owners.insert(disclose(tokenId), disclose(to));
}

export circuit listSale(tokenId: Bytes<32>, price: Uint<64>): [] {
  const sk = localSecretKey();
  const auth = persistentHash<Vector<2, Bytes<32>>>([pad(32, "movenft:minter:v1"), sk]);
  assert(auth != pad(32, ""), "auth");
  assert(disclose(price) > (0 as Uint<64>), "price");
  listed_price.insert(disclose(tokenId), disclose(price));
}

export circuit cancel(listingId: Bytes<32>): [] {
  const sk = localSecretKey();
  const auth = persistentHash<Vector<2, Bytes<32>>>([pad(32, "movenft:minter:v1"), sk]);
  assert(auth != pad(32, ""), "auth");
  // New key each cancel (server supplies listingId) — never overwrite.
  listed_price.insert(disclose(listingId), disclose(0 as Uint<64>));
}

export circuit transfer(transferId: Bytes<32>, buyer: Bytes<32>): [] {
  const sk = localSecretKey();
  const auth = persistentHash<Vector<2, Bytes<32>>>([pad(32, "movenft:minter:v1"), sk]);
  assert(auth != pad(32, ""), "auth");
  sales.insert(disclose(transferId), disclose(buyer));
}

export circuit buy(saleId: Bytes<32>, buyer: Bytes<32>): [] {
  const sk = localSecretKey();
  const auth = persistentHash<Vector<2, Bytes<32>>>([pad(32, "movenft:minter:v1"), sk]);
  assert(auth != pad(32, ""), "auth");
  sales.insert(disclose(saleId), disclose(buyer));
}
